# Gemini API key for AI roadmap generation
# Required for the /api/roadmap serverless function
# Get yours at: https://aistudio.google.com/apikey
#
# This key is used SERVER-SIDE ONLY. It is never exposed to the browser.
# For local development: set this in .env.local (gitignored)
# For Cloudflare Pages: add it in Settings > Environment variables (Production + Preview)
# For Vercel deployment: set in Project Settings > Environment Variables
GEMINI_API_KEY=
